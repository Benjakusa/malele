# Malele Backend — environment template
# Copy to .env and fill in. .env is gitignored.

# --- Core ---
APP_ENV=development
APP_DEBUG=true
APP_NAME=Malele
APP_BASE_URL=http://localhost:8000
APP_FRONTEND_URL=http://localhost:3000
LOG_LEVEL=INFO

# --- Security ---
JWT_SECRET=CHANGE_ME_use_a_64_char_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_HASH_TIME_COST=3
PASSWORD_HASH_MEMORY_COST=65536
PASSWORD_HASH_PARALLELISM=4

# --- Database ---
DATABASE_URL=postgresql+psycopg://malele:malele@localhost:5432/malele

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Storage ---
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage
S3_ENDPOINT=
S3_BUCKET=malele-dev
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
SIGNED_URL_TTL_SECONDS=300

# --- Providers (Phase 1: leave empty. Phase 2: fill.) ---
PROVIDER_MOCK_ENABLED=true
ELEVENLABS_API_KEY=
FAL_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=

# --- Credits ---
CREDITS_SIGNUP_BONUS=50
CREDITS_COST_PER_SONG=10
CREDITS_DAILY_MAX_PER_USER=100
CREDITS_DAILY_MAX_GLOBAL=10000

# --- Kill switches ---
GENERATION_ENABLED=true
ELEVENLABS_ENABLED=false
FAL_ENABLED=false
